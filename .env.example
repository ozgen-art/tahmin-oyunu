# Admin paneline (/admin) giriş şifresi. Zorunlu.
ADMIN_PASSWORD=degistir-beni

# Supabase proje ayarları (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxxxxxxx

# Sadece `npm run migrate` için gerekli — Supabase proje sayfasında
# Connect > "Session pooler" ya da doğrudan bağlantı stringi (Project
# Settings > Database > Connection string > URI, şifreyi kendiniz girin).
DATABASE_URL=postgresql://postgres:<şifre>@db.xxxxxxxxxxxx.supabase.co:5432/postgres?sslmode=require
